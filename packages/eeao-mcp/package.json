{
  "name": "@eeao/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless MCP server for an eeao registry on Cloudflare Workers",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eeao/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@types/node": "catalog:",
    "agents": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": ">=0.33.0"
  }
}
