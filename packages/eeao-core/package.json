{
  "name": "@eeao/core",
  "version": "0.1.0",
  "private": true,
  "description": "Must-choose procedure builder and registry",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit && tsc -p type-tests/tsconfig.json && tsc -p type-tests/tsconfig.perf.json && node type-tests/check-messages.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "expect-type": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
