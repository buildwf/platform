{
  "extends": "./.bwf/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@buildwf/bwf/env"],
    "allowImportingTsExtensions": true
  },
  "include": ["routes", "db"]
}
